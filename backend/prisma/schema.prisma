generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int      @id @default(autoincrement())
  first_name          String?  @db.VarChar(100)
  last_name           String?  @db.VarChar(100)
  email               String   @unique @db.VarChar(255)
  password            String   @db.VarChar(255)
  role                Role     @default(user)
  phone               String?  @db.VarChar(20)
  profile_picture     String?  @db.VarChar(255)
  is_banned           Boolean  @default(false)
  ban_reason          String?  @db.VarChar(255)
  created_at          DateTime @default(now())
  provider            Provider?
  appointments        Appointment[] @relation("ClientAppointments")
  reviews             Review[]      @relation("ClientReviews")
  review_likes        ReviewLike[]  @relation("UserLikes")
  favorites           Favorite[]    @relation("UserFavorites")

  @@map("users")
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String     @unique @db.VarChar(100)
  icon      String     @default("Store") @db.VarChar(50)
  providers Provider[]

  @@map("categories")
}

model Provider {
  id           Int            @id @default(autoincrement())
  user_id      Int?           @unique
  category_id  Int?
  name         String         @db.VarChar(255)
  address      String?        @db.Text
  zip_code     String?        @db.VarChar(10)
  city         String?        @db.VarChar(100)
  description  String?        @db.Text
  phone        String?        @db.VarChar(20)
  image_url    String?        @db.VarChar(255)
  latitude     Float?
  longitude    Float?
  is_certified Boolean        @default(false)
  is_visible   Boolean        @default(true)
  admin_note   String?        @db.Text
  created_at   DateTime       @default(now())
  user         User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  category     Category?      @relation(fields: [category_id], references: [id], onDelete: SetNull)
  services     Service[]
  businessHours BusinessHour[]
  appointments Appointment[]
  reviews      Review[]
  favorites    Favorite[]
  photos       ProviderPhoto[]

  @@map("providers")
}

model ProviderPhoto {
  id            Int      @id @default(autoincrement())
  provider_id   Int
  photo_url     String   @db.VarChar(255)
  is_main       Boolean  @default(false)
  display_order Int      @default(0)
  created_at    DateTime @default(now())
  provider      Provider @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@map("provider_photos")
}

model BusinessHour {
  id          Int       @id @default(autoincrement())
  provider_id Int
  day_of_week DayOfWeek
  open_time   DateTime? @db.Time
  close_time  DateTime? @db.Time
  is_closed   Boolean   @default(false)
  provider    Provider  @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@map("business_hours")
}

model Service {
  id          Int           @id @default(autoincrement())
  provider_id Int
  label       String        @db.VarChar(255)
  price       Decimal       @db.Decimal(10, 2)
  duration    Int           @default(30)
  image_url   String?       @db.VarChar(255)
  provider    Provider      @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("services")
}

model Appointment {
  id               Int               @id @default(autoincrement())
  client_id        Int
  provider_id      Int
  service_id       Int
  appointment_date DateTime
  status           AppointmentStatus @default(pending)
  refusal_reason   String?           @db.Text
  is_slot_released Boolean           @default(false)
  is_read          Boolean           @default(true)
  phone            String?           @db.VarChar(20)
  send_sms_reminder Boolean          @default(false)
  created_at       DateTime          @default(now())
  client           User              @relation("ClientAppointments", fields: [client_id], references: [id], onDelete: Cascade)
  provider         Provider          @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  service          Service           @relation(fields: [service_id], references: [id], onDelete: Cascade)
  review           Review?

  @@map("appointments")
}

model Review {
  id             Int          @id @default(autoincrement())
  client_id      Int
  provider_id    Int
  appointment_id Int          @unique
  rating           Int
  rating_accueil   Int?
  rating_proprete  Int?
  rating_ambiance  Int?
  rating_qualite   Int?
  comment          String?      @db.Text
  created_at       DateTime     @default(now())
  client         User         @relation("ClientReviews", fields: [client_id], references: [id], onDelete: Cascade)
  provider       Provider     @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  appointment    Appointment  @relation(fields: [appointment_id], references: [id], onDelete: Cascade)
  likes          ReviewLike[]

  @@map("reviews")
}

model ReviewLike {
  id         Int      @id @default(autoincrement())
  review_id  Int
  user_id    Int
  created_at DateTime @default(now())
  review     Review   @relation(fields: [review_id], references: [id], onDelete: Cascade)
  user       User     @relation("UserLikes", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([review_id, user_id])
  @@map("review_likes")
}

model Favorite {
  id          Int      @id @default(autoincrement())
  user_id     Int
  provider_id Int
  created_at  DateTime @default(now())
  user        User     @relation("UserFavorites", fields: [user_id], references: [id], onDelete: Cascade)
  provider    Provider @relation(fields: [provider_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider_id])
  @@map("favorites")
}

enum Role {
  user
  pro
  admin
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled
  cancelled_by_pro
  completed
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
  sunday
}
