/* Ce fichier ne sera pas gitignoré, il sert a se rappeler qu'il y a un .env dans ce projet.
   Le .env lui est bien configuré et est gitignoré pour ne pas partager les infos sensibles. */

# ORM Prisma — URL de connexion MySQL
DATABASE_URL=mysql://ordv_user:PASSWORD@localhost:3306/ordv_db

# Securite (JWT)
JWT_SECRET=ta_phrase_secrete_ici

# Configuration du serveur
PORT=5000
FRONTEND_URL=http://localhost:3000

# Cloudinary (stockage images)
CLOUDINARY_CLOUD_NAME=ton_cloud_name
CLOUDINARY_API_KEY=ta_api_key
CLOUDINARY_API_SECRET=ton_api_secret

# Google OAuth
GOOGLE_CLIENT_ID=ton_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ton_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
